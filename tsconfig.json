{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "apps/api/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "worker/**/*.ts",
    "db/**/*.ts",
    "drizzle.config.ts"
  ]
}
